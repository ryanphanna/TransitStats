rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower())).data.isAdmin == true;
    }

    function ownsDoc(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Profiles - users can read/write their own profile. Never publicly readable,
    // even when isPublic is set: the doc carries isAdmin/isPremium and other private
    // fields. The `publicProfile` Cloud Function serves the public subset.
    match /profiles/{userId} {
      allow read: if ownsDoc(userId) || isAdmin();
      allow create: if isAdmin() || (
        ownsDoc(userId) &&
        request.resource.data.isAdmin == false &&
        request.resource.data.isPremium == false
      );
      allow update: if isAdmin() || (
        ownsDoc(userId) &&
        request.resource.data.isAdmin == resource.data.isAdmin &&
        request.resource.data.isPremium == resource.data.isPremium &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'username', 'defaultAgency', 'defaultAgencyMode', 'primaryAgency', 'isPublic',
          'betaFeatures', 'updatedAt', 'isAdmin', 'isPremium'
        ])
      );
      allow delete: if ownsDoc(userId) || isAdmin();
    }

    // Trips - users can read/write their own trips only. Trip docs are never
    // publicly readable, even when isPublic is set — they carry userId, route,
    // stop names, and exact timestamps. The `publicProfile` Cloud Function reads
    // isPublic trips with the Admin SDK and returns only aggregate/anonymized
    // fields for the public profile page.
    match /trips/{tripId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // PRESTO pilot activity stays separate from canonical trip history.
    match /prestoTransactions/{transactionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Templates - users can read/write their own templates
    match /templates/{templateId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Phone numbers - only cloud functions can read/write (admin SDK)
    match /phoneNumbers/{phoneNumber} {
      allow read: if request.auth != null && isAdmin();
      allow write: if false; // Only written/updated by Admin SDK/Functions
    }

    // SMS state - only cloud functions can read/write (admin SDK)
    match /smsState/{phoneNumber} {
      allow read, write: if false;
    }

    // SMS verification - only cloud functions can read/write (admin SDK)
    match /smsVerification/{phoneNumber} {
      allow read, write: if false;
    }

    // Phone login verification - only cloud functions can read/write (admin SDK)
    match /phoneLoginVerification/{phoneNumber} {
      allow read, write: if false;
    }

    // Mail queue - only cloud functions can write (for sending emails)
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Stops collection - public read (transit stop info is public data), admins can write
    match /stops/{stopId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    // Routes collection - authenticated users can read, admins can write
    match /routes/{routeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // Stop→Route mapping (built from GTFS stop_times.txt) - authenticated users can read, admins can write
    match /stopRoutes/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // Rate limits - only cloud functions can read/write
    match /rateLimits/{phoneNumber} {
      allow read, write: if false;
    }

    // Gemini rate limits - only cloud functions can read/write
    match /geminiRateLimits/{phoneNumber} {
      allow read, write: if false;
    }

    // Unknown numbers tracking - only cloud functions can read/write
    match /unknownNumbers/{phoneNumber} {
      allow read, write: if false;
    }

    // Allowed users whitelist - only cloud functions can write
    // Data model: { email: string, isAdmin: boolean }
    // Users can only read their own entry (doc ID == their email)
    // Write operations must be done via Admin SDK only
    match /allowedUsers/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // Usernames - for public profiles
    match /usernames/{username} {
      allow read: if true; // Public profiles must be resolvable without auth
      allow create: if request.auth != null 
        && request.resource.data.uid == request.auth.uid
        && username.size() >= 1
        && username.size() <= 20
        && (
          (request.resource.data.type == 'custom'
            && isAdmin()
            && username.matches('^[a-z0-9-]+$'))
          ||
          (request.resource.data.type == 'emoji'
            && username.matches('^[a-z0-9_-]+$'))
        );
      allow update, delete: if false; // Usernames are permanent for now
    }

    // Prediction Stats - for silent accuracy evaluation
    match /predictionStats/{statId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Prediction Accuracy Summary
    match /predictionAccuracy/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only written/updated by Admin SDK/Functions
    }

    // Rocket Research — public read for research transparency, owner write
    match /rocket_trips/{tripId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
