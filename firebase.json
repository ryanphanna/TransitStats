{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": []
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "main",
      "public": "dist",
      "predeploy": ["npm run build"],
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "functions/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "X-XSS-Protection",
              "value": "1; mode=block"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "geolocation=self, camera=(), microphone=()"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=63072000; includeSubDomains; preload"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://cdnjs.cloudflare.com https://unpkg.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdnjs.cloudflare.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://*.tile.openstreetmap.org https://tile.openstreetmap.org https://*.basemaps.cartocdn.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.cloudfunctions.net https://unpkg.com https://ipapi.co https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/{dashboard,public,rocket}",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, max-age=0, must-revalidate"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/auth/session",
          "function": {
            "functionId": "authSession",
            "region": "us-central1"
          }
        },
        {
          "source": "/public",
          "destination": "/public.html"
        },
        {
          "source": "/public-profile-og",
          "function": {
            "functionId": "publicProfileOg",
            "region": "us-central1"
          }
        },
        {
          "source": "/public-profile-og-v4",
          "function": {
            "functionId": "publicProfileOg",
            "region": "us-central1"
          }
        },
        {
          "source": "/public-profile-og-v5",
          "function": {
            "functionId": "publicProfileOg",
            "region": "us-central1"
          }
        },
        {
          "source": "/public-profile-og-v6",
          "function": {
            "functionId": "publicProfileOg",
            "region": "us-central1"
          }
        },
        {
          "source": "/public-profile-og-v7",
          "function": {
            "functionId": "publicProfileOg",
            "region": "us-central1"
          }
        },
        {
          "source": "/public-profile-og-v8",
          "function": {
            "functionId": "publicProfileOg",
            "region": "us-central1"
          }
        },
        {
          "source": "/public-profile-og-v9",
          "function": {
            "functionId": "publicProfileOg",
            "region": "us-central1"
          }
        },
        {
          "source": "/public-profile-og-v10",
          "function": {
            "functionId": "publicProfileOg",
            "region": "us-central1"
          }
        },
        {
          "source": "/public-profile-og-v11",
          "function": {
            "functionId": "publicProfileOg",
            "region": "us-central1"
          }
        },
        {
          "source": "/user/**",
          "function": {
            "functionId": "publicProfilePage",
            "region": "us-central1"
          }
        },
        {
          "source": "/terms",
          "destination": "/terms.html"
        },
        {
          "source": "/privacy",
          "destination": "/privacy.html"
        },
        {
          "source": "/import",
          "destination": "/import.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
