{
  "name": "transit-stats",
  "version": "1.49.4",
  "description": "Personal transit trip tracker for enthusiasts to analyze ridership patterns.",
  "engines": {
    "node": "22"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanphanna/TransitStats.git"
  },
  "author": "Antigravity & Ryan",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:supplements": "node tests/validate-stop-supplements.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.js\"",
    "sync:shared": "node scripts/sync-shared.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitest/ui": "^5.0.4",
    "firebase": "^12.19.0",
    "jsdom": "^30.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "playwright": "^1.64.1"
  },
  "overrides": {
    "undici": "^7.30.0",
    "@fastify/busboy": "^3.2.2",
    "@grpc/grpc-js": "^1.14.5",
    "@tootallnate/once": "^3.0.1",
    "vite": "^8.3.4",
    "uuid": "^11.1.1",
    "fast-xml-parser": "^5.10.1",
    "postcss": "^8.5.18",
    "brace-expansion": "^5.0.12",
    "nanoid": "^3.3.18",
    "source-map-js": "^1.2.2"
  }
}
